{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2022",
		"lib": ["es2022"],
		"rootDir": ".",
		"outDir": "dist",
		"declaration": true,
		"sourceMap": true,
		"removeComments": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": ["credentials/**/*.ts", "nodes/**/*.ts", "nodes/**/*.json", "shared/**/*.ts"]
}
